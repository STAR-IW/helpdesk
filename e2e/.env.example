# Fully self-contained test environment — independent from the root .env, so
# e2e runs never share a database, secret, or admin account with dev.
# Copy to .env and adjust as needed (DATABASE_URL must match your local Postgres instance).

DATABASE_URL="postgresql://postgres:password@localhost:5432/helpdesk_test?schema=public"

BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:5173"

# Read by the frontend (import.meta.env.VITE_API_URL in src/lib/api.ts and
# src/lib/auth-client.ts) so it knows where the backend is. Must match the
# backend's URL above.
VITE_API_URL="http://localhost:3000"

# Shared secret the inbound-email webhook requires on the X-Webhook-Secret
# header (backend/src/middleware/require-webhook-secret.ts). Any non-empty
# value works for e2e; generate one the same way as BETTER_AUTH_SECRET.
INBOUND_EMAIL_WEBHOOK_SECRET=""

ADMIN_EMAIL="admin@e2e.test"
ADMIN_PASSWORD=""


AGENT_EMAIL="agent@e2e.test"
AGENT_PASSWORD=""